# Copy this file to .env and fill in real values. Never commit .env.
# Note: first deployment assumes a clean (empty) database. If migrating an
# existing database, rename the keycloak_subject column to oidc_subject first.

# Public hostname — the host Traefik routes to the app. PRUEFSTEIN_BASE_URL
# below should be https:// this same host.
PRUEFSTEIN_HOST=pruefstein.example.com

# PostgreSQL
POSTGRES_DB=pruefstein
POSTGRES_USER=pruefstein
POSTGRES_PASSWORD=CHANGE_ME

# Entra ID — values from your app registration in the Azure portal
ENTRA_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ENTRA_CLIENT_SECRET=CHANGE_ME
# The public client MCP clients such as Claude Code sign in as — a second
# registration, see "The Entra ID app registration" in the README. Without it
# the MCP sign-in fails with AADSTS90009.
PRUEFSTEIN_MCP_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Which token claim carries the roles, and which value in it grants admin.
# The defaults below are what the compose file falls back to and match an
# Entra app role named `admin`. Set them when admin comes from a group
# instead: Entra puts group object ids in the `groups` claim, so the role
# becomes that group's object id rather than a name.
#PRUEFSTEIN_SECURITY_ROLE_CLAIM_PATH=groups
#PRUEFSTEIN_SECURITY_ADMIN_ROLE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# OpenAI
OPENAI_API_KEY=sk-CHANGE_ME

# Mail — used for the compliance notification and deadline reminder mails
PRUEFSTEIN_BASE_URL=https://pruefstein.example.com
MAIL_FROM=pruefstein@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
